{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-commerce backend API",
  "main": "src/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "echo 'Backend build complete' && npm run lint",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2"
  }
}
